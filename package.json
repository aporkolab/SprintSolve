{
  "name": "sprintsolve",
  "version": "1.0.0",
  "description": "SprintSolve is a professional, web-based educational trivia game that combines modern development practices with engaging gameplay mechanics.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "precommit": "lint-staged",
    "analyze": "size-limit",
    "lighthouse": "lighthouse http://127.0.0.1:4173/SprintSolve/ --output=json --output-path=./lighthouse-report.json --chrome-flags=\"--headless --no-sandbox --disable-dev-shm-usage\"",
    "test:dependency-guards": "node --test vendor/braces/test.cjs",
    "size": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/APorkolab/SprintSolve.git"
  },
  "keywords": [
    "typescript",
    "game",
    "trivia",
    "education",
    "canvas",
    "vite",
    "progressive-web-app",
    "accessibility",
    "responsive"
  ],
  "author": "Adam Porkolab <email@example.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/APorkolab/SprintSolve/issues"
  },
  "homepage": "https://github.com/APorkolab/SprintSolve#readme",
  "dependencies": {
    "howler": "^2.2.4",
    "i18next": "^26.5.12",
    "i18next-browser-languagedetector": "^8.2.4",
    "i18next-http-backend": "^4.0.7",
    "uuid": "^14.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "braces": "file:vendor/braces",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^24.15.0",
    "npm": ">=8.19.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "overrides": {
    "braces": "$braces"
  }
}
